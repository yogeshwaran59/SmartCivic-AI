# Shared Neon PostgreSQL Database URL (paste your Neon connection string here)
DATABASE_URL=postgresql://user:password@ep-cool-water-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# App Port (Cloud platforms set this automatically, default: 5000)
PORT=5000

# Base URL of your deployed application (e.g., https://smartcivic-ai.onrender.com)
APP_BASE_URL=http://127.0.0.1:5000

# Flask Session & Master Admin Secret Key
SECRET_KEY=smartcivic_admin_secret_session_key_2026_supersecure
ADMIN_EMAIL=admin@smartcivic.ai
ADMIN_PASSWORD=Admin@SmartCivic2026
ADMIN_SECRET_PIN=7890

# Exotel SMS / IVR Call Hotline Credentials (Optional for IVR phone hotline)
EXOTEL_SID=your_exotel_sid
EXOTEL_API_KEY=your_exotel_api_key
EXOTEL_API_TOKEN=your_exotel_api_token
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_CALLER_ID=your_exotel_caller_id

# Gmail SMTP Configuration for Email Notifications
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SENDER_EMAIL=your_email@gmail.com
ENABLE_EMAIL_NOTIFICATIONS=true

# Hugging Face Multilingual AI (Optional token for translation / NLP inference)
HF_TOKEN=your_huggingface_api_token
HUGGINGFACE_API_KEY=your_huggingface_api_token
